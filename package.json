{
  "name": "effect-atproto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "prepare": "bun scripts/prepare.sh",
    "release": "bun run --sequential ts:check fmt:check release:publish",
    "release:publish": "changeset publish",
    "release:version": "changeset version",
    "ts:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/types": "^21.0.1",
    "@effect/language-service": "^0.86.2",
    "dprint": "^0.54.0",
    "effect": "4.0.0-beta.71",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.3.14"
    },
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  }
}
