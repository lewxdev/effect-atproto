{
  "name": "@effect-atproto/syntax",
  "version": "0.0.0",
  "description": "Effect schemas for atproto identifiers and syntax formats.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/lewxdev/effect-atproto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lewxdev/effect-atproto.git",
    "directory": "packages/syntax"
  },
  "keywords": [
    "atproto",
    "did",
    "nsid",
    "effect"
  ],
  "tags": [
    "atproto",
    "did",
    "nsid",
    "effect"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Did": {
      "types": "./dist/Did.d.ts",
      "import": "./dist/Did.js"
    },
    "./Handle": {
      "types": "./dist/Handle.d.ts",
      "import": "./dist/Handle.js"
    },
    "./Nsid": {
      "types": "./dist/Nsid.d.ts",
      "import": "./dist/Nsid.js"
    },
    "./RecordKey": {
      "types": "./dist/RecordKey.d.ts",
      "import": "./dist/RecordKey.js"
    },
    "./Tid": {
      "types": "./dist/Tid.d.ts",
      "import": "./dist/Tid.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "docgen": "bun ../../scripts/docgen.sh .",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
